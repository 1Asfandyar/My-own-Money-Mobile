{
  "name": "my-own-money-manager",
  "main": "expo-router/entry",
  "version": "0.0.2",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "run:android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "fix": "eslint src .ts,.tsx --fix",
    "format": "prettier --write .",
    "test": "tsx --test $(find src -name '*.test.ts' -print)",
    "prebuild:android": "expo prebuild --platform android",
    "prepare:android:release": "expo prebuild --platform android --non-interactive",
    "keystore:android:generate:pkcs12": "mkdir -p android/app && keytool -genkeypair -v -storetype PKCS12 -keystore android/app/upload-keystore.p12 -alias upload -keyalg RSA -keysize 2048 -validity 10000",
    "build:android:release:aab": "expo prebuild --platform android --non-interactive && cd android && ./gradlew bundleRelease",
    "build:android:release:aab:vc": "ANDROID_VERSION_CODE=${ANDROID_VERSION_CODE:-2} expo prebuild --platform android --non-interactive && cd android && ./gradlew bundleRelease",
    "build:android:release:apk": "expo prebuild --platform android --non-interactive && cd android && ./gradlew assembleRelease",
    "clean:android": "cd android && ./gradlew clean"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/stack": "^7.8.11",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "formik": "^2.4.9",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "rollbar": "^3.1.0",
    "rollbar-react-native": "^1.0.1",
    "yup": "^1.7.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eas-cli": "^20.5.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "~5.9.2"
  },
  "private": true
}
